              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "category"
              ]
            },
            "description": "Creates a new category. `name` is required and must be unique (409 on duplicate).\n\nThe created id is saved to `{{categoryId}}` for the other category/product requests. `{{$timestamp}}` keeps the name unique so this can be re-run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Category {{$timestamp}}\",\n  \"description\": \"Category created from Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const id = json && json.body && json.body.category && json.body.category.id;",
                  "",
                  "if (id) {",
                  "    pm.collectionVariables.set(\"categoryId\", id);",
                  "    console.log(\"Saved category id to {{categoryId}}: \" + id);",
                  "}"
                ]
              }
            }
          ]
        },
