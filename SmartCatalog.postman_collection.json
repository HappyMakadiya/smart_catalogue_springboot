    {
      "name": "Category",
      "description": "Category CRUD + CSV seeding (`/api/category`). Requires JWT.",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
